# Upload-key signing values for every app in all-app.json. Copy to .env and fill in.
# Use absolute paths with forward slashes. PKCS12 keystores use the same password for store and key.
# `python app.py keygen <app>` creates a missing keystore and writes these values to .env for you.
# <PREFIX>_AAB_PATH is the .aab that menu option 11 / `python app.py upload <app>` sends to Google Play,
# e.g. C:/all-projects/battleship/release/app-release.aab

# Google Play Console API (see README.md for how to create this key)
# Absolute path to the service account JSON key. Keep it outside this repo, e.g. in ~/.android-keys/.
PLAY_SERVICE_ACCOUNT_JSON=

# HabitCare (habit-app)
MYAPP_UPLOAD_STORE_FILE=
MYAPP_UPLOAD_KEY_ALIAS=
MYAPP_UPLOAD_STORE_PASSWORD=
MYAPP_UPLOAD_KEY_PASSWORD=
MYAPP_PACKAGE_NAME=
MYAPP_AAB_PATH=

# Connect the Dots (connect-the-dots)
CTD_UPLOAD_STORE_FILE=
CTD_UPLOAD_KEY_ALIAS=
CTD_UPLOAD_STORE_PASSWORD=
CTD_UPLOAD_KEY_PASSWORD=
CTD_PACKAGE_NAME=
CTD_AAB_PATH=

# Arrow Escape (arrow-escape-app)
ARROW_ESCAPE_UPLOAD_STORE_FILE=
ARROW_ESCAPE_UPLOAD_KEY_ALIAS=
ARROW_ESCAPE_UPLOAD_STORE_PASSWORD=
ARROW_ESCAPE_UPLOAD_KEY_PASSWORD=
ARROW_ESCAPE_PACKAGE_NAME=
ARROW_ESCAPE_AAB_PATH=

# AR Games (AR-games)
AR_GAMES_UPLOAD_STORE_FILE=
AR_GAMES_UPLOAD_KEY_ALIAS=
AR_GAMES_UPLOAD_STORE_PASSWORD=
AR_GAMES_UPLOAD_KEY_PASSWORD=
AR_GAMES_PACKAGE_NAME=
AR_GAMES_AAB_PATH=

# Battleship (battleship)
BATTLESHIP_UPLOAD_STORE_FILE=
BATTLESHIP_UPLOAD_KEY_ALIAS=
BATTLESHIP_UPLOAD_STORE_PASSWORD=
BATTLESHIP_UPLOAD_KEY_PASSWORD=
BATTLESHIP_PACKAGE_NAME=
BATTLESHIP_AAB_PATH=

# Scroll Guard (scroll-guard)
SCROLL_GUARD_UPLOAD_STORE_FILE=
SCROLL_GUARD_UPLOAD_KEY_ALIAS=
SCROLL_GUARD_UPLOAD_STORE_PASSWORD=
SCROLL_GUARD_UPLOAD_KEY_PASSWORD=
SCROLL_GUARD_PACKAGE_NAME=
SCROLL_GUARD_AAB_PATH=
